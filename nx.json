{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "analytics": false,
  "plugins": [
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "typecheck": {
          "targetName": "typecheck"
        },
        "build": {
          "targetName": "build",
          "configName": "tsconfig.lib.json"
        }
      }
    },
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      },
      "exclude": ["packages/connectors/manifest/src/fixtures/**"]
    },
    "@zukhruf/nx/lint",
    "@zukhruf/nx/test",
    "@zukhruf/nx/format"
  ],
  "targetDefaults": {
    "typecheck": {
      "dependsOn": ["format:check", "lint", "...", "generate", "^sdk"],
      "inputs": [
        "...",
        {
          "dependentTasksOutputFiles": "**/*.ts"
        }
      ]
    },
    "test": {
      "dependsOn": ["...", "build", "generate", "^sdk"]
    },
    "build": {
      "dependsOn": ["generate", "^sdk", "..."],
      "inputs": [
        "...",
        {
          "dependentTasksOutputFiles": "**/*.ts"
        }
      ]
    },
    "lint": {
      "dependsOn": ["generate", "^sdk", "^build", "..."],
      "inputs": [
        "...",
        {
          "dependentTasksOutputFiles": "**/*.ts"
        }
      ]
    },
    "dev": {
      "dependsOn": ["generate", "^sdk", "..."]
    }
  },
  "sync": {
    "applyChanges": true
  },
  "affected": {
    "legacy": true
  }
}
