  "directProbeSource": "import Foundation\nimport Vision\nimport CoreML\nimport CryptoKit\n\nstruct Input: Decodable { let path: String }\nlet args = CommandLine.arguments\nlet manifest = try JSONDecoder().decode([Input].self, from: Data(contentsOf: URL(fileURLWithPath: args[1])))\nlet urlInput = args[3].hasPrefix(\"url-\")\nlet mode = urlInput ? String(args[3].dropFirst(4)) : args[3]\nlet count = Int(args[4])!\nlet inputs = try manifest.map { try Data(contentsOf: URL(fileURLWithPath: $0.path)) }\nlet hashes = inputs.map { SHA256.hash(data: $0).map { String(format: \"%02x\", $0) }.joined() }\nfunc name(_ device: MLComputeDevice) -> String {\n    switch device { case .cpu: return \"cpu\"; case .gpu: return \"gpu\"; case .neuralEngine: return \"neuralEngine\"; @unknown default: return \"unknown\" }\n}\nvar records: [[String: Any]] = []\nvar configuration: [String: Any] = [:]\nlet start = Date()\nfor i in 0..<count {\n    try autoreleasepool {\n        let input = i % inputs.count\n        let request = VNRecognizeTextRequest()\n        request.recognitionLevel = .accurate\n        request.automaticallyDetectsLanguage = true\n        if mode == \"uncorrected\" { request.usesLanguageCorrection = false }\n        if mode == \"languages\" { request.automaticallyDetectsLanguage = false; request.recognitionLanguages = [\"en-US\", \"ar-SA\"] }\n        let supported = try request.supportedComputeStageDevices\n        if mode == \"cpu\" || mode == \"gpu\" || mode == \"neuralEngine\" {\n            for (stage, devices) in supported {\n                guard let device = devices.first(where: { name($0) == mode }) else { fatalError(\"Unsupported \\(mode) for \\(stage)\") }\n                request.setComputeDevice(device, for: stage)\n            }\n        }\n        if i == 0 {\n            configuration = [\"revision\": request.revision, \"languageCorrection\": request.usesLanguageCorrection,\n                \"autoLanguage\": request.automaticallyDetectsLanguage, \"languages\": request.recognitionLanguages,\n                \"supported\": Dictionary(uniqueKeysWithValues: supported.map { ($0.key.rawValue, $0.value.map(name)) }),\n                \"assigned\": Dictionary(uniqueKeysWithValues: supported.keys.map { ($0.rawValue, request.computeDevice(for: $0).map(name) ?? \"automatic\") })]\n        }\n        let handler = urlInput\n            ? VNImageRequestHandler(url: URL(fileURLWithPath: manifest[input].path))\n            : VNImageRequestHandler(data: inputs[input])\n        try handler.perform([request])\n        let observations = (request.results ?? []).map { observation -> [String: Any] in\n            let box = observation.boundingBox\n            return [\"box\": [box.origin.x, box.origin.y, box.size.width, box.size.height],\n                \"candidates\": observation.topCandidates(3).map { [\"text\": $0.string, \"confidence\": $0.confidence] as [String: Any] }]\n        }\n        records.append([\"iteration\": i, \"input\": input, \"sha256\": hashes[input], \"observations\": observations])\n    }\n}\nlet result: [String: Any] = [\"pid\": ProcessInfo.processInfo.processIdentifier, \"mode\": mode,\n    \"configuration\": configuration, \"elapsed\": Date().timeIntervalSince(start), \"records\": records]\ntry JSONSerialization.data(withJSONObject: result, options: [.sortedKeys]).write(to: URL(fileURLWithPath: args[2]))\n",
