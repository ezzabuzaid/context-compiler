# The @workspace packages are this repository's own and are not published. An
# address nothing listens on makes npm fail on one that is not linked, instead
# of fetching a stranger's package of that name from the public registry
# (dependency confusion). elt's @eltjs packages are workspaces linked from the
# sibling ../elt checkout, so a link wins over the same name on npm.
@workspace:registry=http://127.0.0.1:9/
