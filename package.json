  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nx/devkit": "23.2.1",
    "@nx/esbuild": "23.2.1",
    "@nx/eslint": "23.2.1",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/js": "23.2.1",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/node": "26.6.1",
    "@zukhruf/git-hooks": "0.3.44",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "eslint-plugin-functional": "10.0.1",
    "eslint-plugin-import-x": "4.17.1",
    "nx": "23.2.1",
    "prettier": "3.9.9",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.0"
  }
