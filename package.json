{
  "name": "context-compiler",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/connectors/*",
    "apps/*",
    "../elt/packages/*",
    "../elt/packages/destinations/*",
    "../elt/packages/sdks/*/*",
    "../elt/packages/codecs/*",
    "../elt/packages/sources/*/*"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .husky || exit 0"
  },
  "devDependencies": {
    "@e18e/eslint-plugin": "^0.8.1",
    "@eslint-react/eslint-plugin": "5.30.6",
    "@eslint/js": "10.0.1",
    "@nx/devkit": "24.0.6",
    "@nx/esbuild": "24.0.6",
    "@nx/eslint": "24.0.6",
    "@nx/eslint-plugin": "24.0.6",
    "@nx/js": "24.0.6",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/node": "26.6.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "@zukhruf/eslint": "^0.8.105",
    "@zukhruf/git-hooks": "^0.8.105",
    "@zukhruf/nx": "^0.8.105",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "eslint-plugin-functional": "10.0.1",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-you-might-not-need-an-effect": "1.3.1",
    "eslint-plugin-unicorn": "80.0.0",
    "jsonc-eslint-parser": "3.3.0",
    "nx": "24.0.6",
    "prettier": "3.10.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.73.0"
  },
  "allowScripts": {
    "esbuild": true,
    "@mongodb-js/zstd": true,
    "node-liblzma": true,
    "nx": false,
    "unrs-resolver": false,
    "fsevents": false,
    "protobufjs": false,
    "ssh2": false,
    "cpu-features": false
  }
}
