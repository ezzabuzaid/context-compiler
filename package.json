{
  "name": "context-compiler",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/connectors/*",
    "apps/*",
    "../elt/packages/*",
    "../elt/packages/destinations/*",
    "../elt/packages/sdks/*/*",
    "../elt/packages/codecs/*",
    "../elt/packages/sources/*/*"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .husky || exit 0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nx/devkit": "23.2.1",
    "@nx/esbuild": "23.2.1",
    "@nx/eslint": "23.2.1",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/js": "23.2.1",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/node": "26.6.1",
    "@zukhruf/eslint": "0.6.5",
    "@zukhruf/git-hooks": "0.6.4",
    "@zukhruf/nx": "0.6.4",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "eslint-plugin-functional": "10.0.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsonc-eslint-parser": "3.3.0",
    "nx": "23.2.1",
    "prettier": "3.9.9",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.0"
  },
  "overrides": {
    "eslint-plugin-import": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  }
}
