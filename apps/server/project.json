{
  "name": "server",
  "sourceRoot": "apps/server/src",
  "projectType": "application",
  "targets": {
    "bundle": {
      "command": "node apps/server/build.mjs",
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/plugins/context-compiler/.codex-plugin/plugin.json",
        "{workspaceRoot}/plugins/context-compiler/assets/composer-icon.png"
      ],
      "outputs": ["{projectRoot}/dist/server"]
    },
    "test": {
      "dependsOn": [
        "...",
        {
          "projects": ["plugin"],
          "target": "bundle"
        }
      ]
    }
  }
}
