{
  "name": "websets",
  "sourceRoot": "apps/websets/src",
  "projectType": "application",
  "targets": {
    "start": {
      "dependsOn": ["build"],
      "command": "node apps/websets/dist/main.js"
    },
    "openapi": {
      "command": "node apps/websets/openapi.ts",
      "outputs": [
        "{projectRoot}/openapi.json",
        "{workspaceRoot}/packages/websets-client/src"
      ]
    }
  }
}
