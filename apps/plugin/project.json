{
  "name": "plugin",
  "projectType": "application",
  "targets": {
    "format": {},
    "bundle": {
      "command": "node apps/plugin/build.mjs",
      "dependsOn": [
        {
          "projects": ["server"],
          "target": "bundle"
        }
      ],
      "cache": true,
      "inputs": ["default", { "dependentTasksOutputFiles": "**/*" }],
      "outputs": ["{workspaceRoot}/plugins/context-compiler/server"]
    },
    "marketplace": {
      "dependsOn": ["bundle"],
      "command": "rm -rf dist/plugin-marketplace && mkdir -p dist/plugin-marketplace/.agents/plugins dist/plugin-marketplace/plugins && cp .agents/plugins/marketplace.json dist/plugin-marketplace/.agents/plugins/ && cp -R plugins/context-compiler dist/plugin-marketplace/plugins/"
    },
    "install": {
      "dependsOn": ["marketplace"],
      "command": "node apps/plugin/stamp-install.mjs && /Applications/ChatGPT.app/Contents/Resources/codex-cli/CodexCLI.app/Contents/MacOS/codex plugin add context-compiler@context-compiler"
    },
    "release": {
      "dependsOn": ["test", "marketplace"],
      "command": "node apps/plugin/release.mjs"
    },
    "test": {
      "executor": "nx:noop",
      "dependsOn": [
        {
          "projects": ["server"],
          "target": "test",
          "params": "forward"
        }
      ]
    },
    "typecheck": {
      "executor": "nx:noop",
      "dependsOn": [
        "lint",
        {
          "projects": ["server"],
          "target": "typecheck"
        }
      ]
    }
  }
}
