{
  "name": "startup-credits",
  "sourceRoot": "apps/startup-credits/src",
  "projectType": "application",
  "targets": {
    "format": {},
    "start": {
      "dependsOn": ["build"],
      "command": "node apps/startup-credits/dist/main.js"
    },
    "eval-seed": {
      "command": "node apps/startup-credits/eval/seed.ts"
    },
    "eval": {
      "command": "node apps/startup-credits/eval/score.ts {args}"
    },
    "eval-kinds": {
      "command": "node apps/startup-credits/eval/kinds.ts {args}"
    },
    "eval-predict": {
      "command": "node apps/startup-credits/eval/predict.ts {args}"
    },
    "promptfoo": {
      "dependsOn": ["^build"],
      "command": "promptfoo eval -c promptfoo/promptfooconfig.yaml --tag commit=$(git rev-parse --short HEAD)$(test -z \"$(git status --porcelain -- .)\" || echo -dirty) {args}",
      "options": {
        "cwd": "apps/startup-credits",
        "env": {
          "PROMPTFOO_PASS_RATE_THRESHOLD": "0",
          "PROMPTFOO_DISABLE_TELEMETRY": "1",
          "PROMPTFOO_DISABLE_UPDATE": "1",
          "PROMPTFOO_DISABLE_SHARING": "true"
        }
      }
    },
    "promptfoo-view": {
      "command": "promptfoo view {args}",
      "options": {
        "cwd": "apps/startup-credits",
        "env": {
          "PROMPTFOO_DISABLE_TELEMETRY": "1",
          "PROMPTFOO_DISABLE_UPDATE": "1",
          "PROMPTFOO_DISABLE_SHARING": "true"
        }
      }
    }
  }
}
