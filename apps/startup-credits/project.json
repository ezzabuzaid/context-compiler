{
  "name": "startup-credits",
  "sourceRoot": "apps/startup-credits/src",
  "projectType": "application",
  "targets": {
    "start": {
      "dependsOn": ["build"],
      "command": "node apps/startup-credits/dist/main.js"
    },
    "eval-seed": {
      "command": "node apps/startup-credits/promptfoo/dataset/seed.ts"
    },
    "promptfoo": {
      "dependsOn": ["^build"],
      "command": "promptfoo eval -c promptfoo/promptfooconfig.ts --tag commit=$(git rev-parse --short HEAD)$(test -z \"$(git status --porcelain -- .)\" || echo -dirty) {args}",
      "options": {
        "cwd": "apps/startup-credits",
        "env": {
          "PROMPTFOO_PASS_RATE_THRESHOLD": "0",
          "PROMPTFOO_DISABLE_TELEMETRY": "1",
          "PROMPTFOO_DISABLE_UPDATE": "1",
          "PROMPTFOO_DISABLE_SHARING": "true"
        }
      }
    },
    "promptfoo-kinds": {
      "dependsOn": ["^build"],
      "command": "promptfoo eval -c promptfoo/page-kinds.config.ts --tag commit=$(git rev-parse --short HEAD)$(test -z \"$(git status --porcelain -- .)\" || echo -dirty) {args}",
      "options": {
        "cwd": "apps/startup-credits",
        "env": {
          "PROMPTFOO_PASS_RATE_THRESHOLD": "0",
          "PROMPTFOO_DISABLE_TELEMETRY": "1",
          "PROMPTFOO_DISABLE_UPDATE": "1",
          "PROMPTFOO_DISABLE_SHARING": "true"
        }
      }
    },
    "promptfoo-retry": {
      "dependsOn": ["^build"],
      "command": "promptfoo retry {args}",
      "options": {
        "cwd": "apps/startup-credits",
        "env": {
          "PROMPTFOO_PASS_RATE_THRESHOLD": "0",
          "PROMPTFOO_DISABLE_TELEMETRY": "1",
          "PROMPTFOO_DISABLE_UPDATE": "1",
          "PROMPTFOO_DISABLE_SHARING": "true"
        }
      }
    },
    "promptfoo-view": {
      "command": "promptfoo view {args}",
      "options": {
        "cwd": "apps/startup-credits",
        "env": {
          "PROMPTFOO_DISABLE_TELEMETRY": "1",
          "PROMPTFOO_DISABLE_UPDATE": "1",
          "PROMPTFOO_DISABLE_SHARING": "true"
        }
      }
    }
  }
}
