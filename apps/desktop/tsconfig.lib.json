{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": ".",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "jsx": "react-jsx",
    "types": ["node", "vite/client"]
  },
  "include": [
    "src/**/*.ts",
    "frontend/src/**/*.tsx",
    "frontend/vite.config.mts"
  ],
  "exclude": ["src/**/*.test.ts"],
  "references": [
    {
      "path": "../../packages/ui/tsconfig.lib.json"
    }
  ]
}
